---
// Potent — landing page. Phase 1: full-viewport "open water" hero, no DOM text yet.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Potent</title>
  </head>
  <body>
    <canvas id="ocean"></canvas>
    <div id="scroll-space" aria-hidden="true"></div>
    <pre id="err"></pre>

    <script>
      import { mountOpenWater } from '../lib/openWater.js';
      import { bindScrollCamera } from '../lib/scrollCamera.js';
      import { createFlyCamera } from '../lib/flyCamera.js';
      const canvas = document.getElementById('ocean');
      mountOpenWater(canvas)
        .then(async (scene) => {
          // Dev-only tuning panel. Dynamic import (not a static one) because tweakpane has no
          // sideEffects:false, so Rollup can't prove it's safe to drop from a dead branch --
          // this way the import call itself never executes (and its chunk never even builds)
          // once import.meta.env.DEV is statically false in production.
          if (import.meta.env.DEV) {
            const { createControlPanel } = await import('../lib/controlPanel.js');
            createControlPanel(scene);
          }
          bindScrollCamera(scene.view, scene.carrier);
          createFlyCamera(scene.app, scene.camera, canvas);
        })
        .catch((err) => {
          console.error(err);
          const box = document.getElementById('err');
          box.style.display = 'block';
          box.textContent = err && (err.stack || err.message || String(err));
        });
    </script>

    <style is:global>
      html, body { margin: 0; background: #04070d; }
      #ocean { position: fixed; inset: 0; width: 100vw; height: 100vh; display: block; }
      /* No DOM hero content yet — this is scroll length for scrollCamera.js to scrub against. */
      #scroll-space { height: 300vh; }
      #err {
        position: fixed; left: 12px; top: 12px; max-width: 92vw; margin: 0;
        color: #ff6b6b; font: 12px/1.45 ui-monospace, SFMono-Regular, Menlo, monospace;
        white-space: pre-wrap; display: none; z-index: 10;
      }
    </style>
  </body>
</html>
